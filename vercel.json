{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "{server/templates/**,app.json}"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
