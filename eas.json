      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "appeumetreino.vercel.app:443",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "471522397558-prav14pvcopf2liqm9a0vdl5r3qa3gll.apps.googleusercontent.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "appeumetreino.vercel.app:443",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "471522397558-prav14pvcopf2liqm9a0vdl5r3qa3gll.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
