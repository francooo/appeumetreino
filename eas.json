{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "appeumetreino.vercel.app:443",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "464677533457-ssi1l7f656rp8efgsakq62roag5tns13.apps.googleusercontent.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "appeumetreino.vercel.app:443",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID": "464677533457-ssi1l7f656rp8efgsakq62roag5tns13.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production"
      }
    }
  }
}
