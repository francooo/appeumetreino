# Banco de dados (obrigatório para o servidor API)
# Ex.: Neon: postgresql://user:pass@host/db?sslmode=require
# Ou Postgres local: postgresql://localhost:5432/eumetreino
DATABASE_URL=postgresql://neondb_owner:SUA_NOVA_SENHA@ep-sweet-bird-ainkqkkk-pooler.c-4.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Opcional: domínio público (deixe em branco para dev com Expo Go)
# Para rede local: EXPO_PUBLIC_DOMAIN=192.168.18.149:5000
# Para tunnel (sem firewall): EXPO_PUBLIC_DOMAIN=abc123.ngrok-free.app (após rodar npm run tunnel:api)
# EXPO_PUBLIC_DOMAIN=

# Groq - reconhecimento de equipamentos por imagem
# Obtenha em: https://console.groq.com/keys
# GROQ_API_KEY=sua_chave_aqui
# Opcional: modelo com suporte a imagem (padrao: qwen/qwen3.8-27b)
# GROQ_MODEL=

